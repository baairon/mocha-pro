{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result file: one per unit and rung, with its counts, comparator, judge, mutants, call records and blockers",
  "type": "object",
  "required": [
    "unit",
    "rung",
    "entry",
    "route",
    "judge",
    "comparator",
    "original",
    "port",
    "seeds",
    "cases",
    "values",
    "branches",
    "value_classes",
    "sites",
    "mutants",
    "call_records",
    "stand_ins",
    "harness_stand_ins",
    "qualifiers",
    "not_rebuilt",
    "commands",
    "measured_at",
    "blockers"
  ],
  "additionalProperties": false,
  "properties": {
    "unit": {
      "type": "string"
    },
    "rung": {
      "enum": [
        "K-PARITY",
        "R-PARITY",
        "REC-PARITY",
        "SELECTION-PARITY",
        "PLAN-PARITY",
        "E-PARITY",
        null
      ],
      "description": "null is allowed for a unit that carries pairing and calibration only; such a unit is never a parity unit"
    },
    "entry": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "judge": {
      "type": "object",
      "required": [
        "engine",
        "manual_follows",
        "cross_checked"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "manual_follows": {
          "type": "boolean"
        },
        "cross_checked": {
          "type": "boolean"
        }
      }
    },
    "comparator": {
      "type": "object",
      "required": [
        "tolerance_ulp",
        "nan_rule",
        "signed_zero"
      ],
      "properties": {
        "tolerance_ulp": {
          "type": "number"
        },
        "nan_rule": {
          "type": "string"
        },
        "signed_zero": {
          "type": "string"
        }
      }
    },
    "original": {
      "type": "object",
      "required": [
        "artifact_sha256",
        "data_sources"
      ],
      "properties": {
        "artifact_sha256": {
          "type": "string"
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "source_sha256",
        "build_profile"
      ],
      "properties": {
        "source_sha256": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "object",
      "required": [
        "in_contract",
        "compared",
        "identical",
        "differing",
        "out_of_contract",
        "blocked",
        "logic_parity"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "values": {
      "type": "object",
      "required": [
        "compared",
        "differing",
        "max_ulp",
        "nan_class_equal_payload_differs"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "branches": {
      "type": "object",
      "required": [
        "total",
        "both_ways",
        "unreached"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "both_ways": {
          "type": "integer"
        },
        "unreached": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "site",
              "reason"
            ],
            "properties": {
              "site": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "value_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "site",
          "killed_by_mutant"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fma",
              "estimate",
              "conversion"
            ]
          },
          "site": {
            "type": "string"
          },
          "killed_by_mutant": {
            "type": "string"
          }
        }
      }
    },
    "mutants": {
      "type": "object",
      "required": [
        "total",
        "killed",
        "control_matches_release",
        "survivors"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "killed": {
          "type": "integer"
        },
        "control_matches_release": {
          "type": "boolean"
        },
        "survivors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "argument": {
                "type": "string"
              },
              "reviewed_by": {
                "type": "string"
              },
              "killed_by_added_case": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "call_records": {
      "type": "object",
      "required": [
        "compared",
        "matching",
        "not_recordable"
      ],
      "properties": {
        "compared": {
          "type": "integer"
        },
        "matching": {
          "type": "integer"
        },
        "not_recordable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stand_ins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "harness_stand_ins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_rebuilt": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measured_at": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "description": "Each entry: \"G1: <condition>\" (gate id, condition), then ' | record: <path> sha256: <64 hex>' naming the call record that shows it. Empty list means not blocked.",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+: .+ \\| record: \\S+ sha256: [0-9a-f]{64}$"
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "max_values_per_case": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "value_classes_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Declared in the unit README contract; floor met only when non-empty and every member is in value_classes"
    },
    "pairing": {
      "type": "object",
      "required": [
        "params_original",
        "params_rewrite",
        "exact",
        "normalized",
        "unmatched"
      ],
      "properties": {
        "params_original": {
          "type": "integer",
          "minimum": 0
        },
        "params_rewrite": {
          "type": "integer",
          "minimum": 0
        },
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "normalized": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": [
        "boots",
        "records_identical",
        "dumps_identical",
        "record_sha256"
      ],
      "properties": {
        "boots": {
          "type": "integer",
          "minimum": 0
        },
        "records_identical": {
          "type": "boolean"
        },
        "dumps_identical": {
          "type": "boolean"
        },
        "record_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "one per boot"
        }
      }
    },
    "rows_basis": {
      "type": "object",
      "description": "Optional. For a unit whose rows are partly READ from a specification and partly observed. Such a unit has the status 'Read and partly observed' and is never a parity unit, whatever its rung; a partial observation is not a result of record.",
      "required": [
        "rows_total",
        "rows_read",
        "rows_observed",
        "observation_label"
      ],
      "additionalProperties": false,
      "properties": {
        "rows_total": {
          "type": "integer",
          "minimum": 1
        },
        "rows_read": {
          "type": "integer",
          "minimum": 0,
          "description": "rows with no observation, known from the specification only"
        },
        "rows_observed": {
          "type": "integer",
          "minimum": 0,
          "description": "rows observed (a partial observation); rows_read + rows_observed must equal rows_total"
        },
        "observation_label": {
          "const": "partial observation, not a result of record"
        }
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. For a unit whose outputs are frames. Absent for every other unit. Comparator at each depth: depth 8 and 16 samples are unsigned integers, so comparator.tolerance_ulp counts integer code steps (a whole number) and the NaN and signed zero rules do not apply; depth 32 samples are floats, so tolerance_ulp counts float ulps and comparator.nan_rule and comparator.signed_zero apply as written. reference_kind 'owner supplied frames' can never reach the Matches or Verified tiers; the status prints its own fixed label.",
      "required": [
        "reference_kind",
        "geometries",
        "frames_compared",
        "frames_identical"
      ],
      "properties": {
        "reference_kind": {
          "enum": [
            "emulated original",
            "owner supplied frames"
          ]
        },
        "geometries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "depth",
              "frames_compared",
              "frames_identical"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "depth": {
                "enum": [
                  8,
                  16,
                  32
                ],
                "description": "bits per sample: 8 rgba, 16 rgba64le, 32 gbrapf32le"
              },
              "frames_compared": {
                "type": "integer",
                "minimum": 0,
                "description": "the frame count compared at this geometry"
              },
              "frames_identical": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "the geometry set compared, one entry per distinct width, height and depth; the frame count of an entry is its frames_compared"
        },
        "frames_compared": {
          "type": "integer",
          "minimum": 0,
          "description": "equals the sum of the entries; at least cases.compared"
        },
        "frames_identical": {
          "type": "integer",
          "minimum": 0,
          "description": "equals the sum of the entries; not above frames_compared"
        }
      }
    }
  }
}
