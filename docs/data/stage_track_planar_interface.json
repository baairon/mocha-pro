{
  "schema_version": 1,
  "name": "stage-track-planar",
  "summary": "The interface of the generic stage track-planar of mocha-stage: a temporal stage that writes every frame as it was read and writes one pose per frame to a key file. Each exit code row is held by crates/stage-cli/tests/interface_track_planar.rs, which runs the built program.",
  "binaries": [
    {"name": "mocha-stage", "arguments": "apply track-planar --width W --height H --depth 8|16|32 --fps N[/D] [--frames N] [--param K=V]...; with --describe the geometry answer is printed and nothing is read", "stdin": "whole raw frames of the frame contract", "stdout": "the same frames, unchanged", "stderr": "empty on exit 0; exactly one line error: CODE: MESSAGE on a failure"}
  ],
  "frame_contract": "Depth 8 is packed R, G, B, A in 4 bytes per pixel, depth 16 is packed R, G, B, A as unsigned 16 bit little endian in 8 bytes, depth 32 is four planes G, B, R, A of 32 bit little endian floats in 16 bytes. Frames are whole frames back to back, a frame is at most 4 GiB, and an input that ends inside a frame is a partial frame.",
  "geometry": "preserve: the output has the width, height, depth, rate and frame count of the input; --describe answers the request",
  "kind": "temporal, spool false: frame N is written once it has been tracked",
  "layers": "none",
  "sample_rule": "The grey level the tracker reads is luma_r * R + luma_g * G + luma_b * B on the samples scaled to full scale 1 (depth 8 divided by 255, depth 16 by 65535, depth 32 as stored). Alpha is not read. The frames themselves are written byte for byte.",
  "data_file": "The parameter data names a key file of form keys-1: the line keys-1, one comment line, the line start 0, then for every frame N the nine lines key m00 N VALUE linear to key m22 N VALUE linear, row major. The matrix maps a point of the reference frame to the same point of the tracked surface in frame N, in pixels with the centre of the first pixel at 0, scaled so that m22 is 1. The file is written under a temporary name in the folder of the target and renamed when the input has ended; a run that fails leaves the target path as it was.",
  "report_file": "The parameter report names a table: the line track-report-1, one comment line that names the ten columns (frame, source, stop, converged, iterations, rms, valid_fraction, inlier_fraction, gain, offset), then one row per frame with the cells separated by one blank. source is reference, tracked or held; stop is none, step-tol, cost-tol, lambda-max, max-iterations, max-rejections, no-pixels or refused. A held row follows a comment line that gives the refusal.",
  "refusal_rule": "A frame the tracker refuses keeps the pose of its neighbour towards the reference when refusal is hold, and ends the run as unsupported when refusal is fail.",
  "error_line": "error: CODE: MESSAGE, where CODE is stage_failed, usage, unsupported, bad_input, partial_frame or broken_pipe",
  "parameters": [
    {"param": "data", "kind": "text", "default": "", "maps_to": "the stage"},
    {"param": "report", "kind": "text", "default": "", "maps_to": "the stage"},
    {"param": "x0", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "y0", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "x1", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "y1", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "x2", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "y2", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "x3", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "y3", "kind": "float", "default": "0", "range": "-1e+09 to 1e+09", "maps_to": "the stage"},
    {"param": "reference", "kind": "int", "default": "0", "range": "0 to 1000000000", "maps_to": "the stage"},
    {"param": "luma_r", "kind": "float", "default": "0.2126", "range": "0 to 1", "maps_to": "the stage"},
    {"param": "luma_g", "kind": "float", "default": "0.7152", "range": "0 to 1", "maps_to": "the stage"},
    {"param": "luma_b", "kind": "float", "default": "0.0722", "range": "0 to 1", "maps_to": "the stage"},
    {"param": "dof", "kind": "popup", "default": "affine", "choices": "translation, trans-scale, similarity, affine, homography", "maps_to": "Config::dof"},
    {"param": "rule", "kind": "popup", "default": "inverse-compositional", "choices": "forward-additive, forward-compositional, inverse-compositional, esm", "maps_to": "Config::rule"},
    {"param": "illumination", "kind": "popup", "default": "off", "choices": "off, joint, alternate", "maps_to": "Config::illumination"},
    {"param": "damping", "kind": "popup", "default": "marquardt", "choices": "levenberg, marquardt", "maps_to": "LmConfig::damping"},
    {"param": "acceptance", "kind": "popup", "default": "decrease", "choices": "decrease, decrease-or-equal, gain-ratio", "maps_to": "LmConfig::acceptance"},
    {"param": "gain_ratio", "kind": "float", "default": "0", "range": "0 to 0.999", "maps_to": "the stage"},
    {"param": "boundary", "kind": "popup", "default": "off", "choices": "off, linear, smoothstep, quadratic", "maps_to": "SelectionConfig::boundary"},
    {"param": "boundary_ramp", "kind": "float", "default": "4", "range": "1e-06 to 65536", "maps_to": "the stage"},
    {"param": "velocity", "kind": "popup", "default": "off", "choices": "off, constant-image-space", "maps_to": "Config::velocity"},
    {"param": "pyramid_levels", "kind": "int", "default": "4", "range": "1 to 16", "maps_to": "PyramidConfig::levels"},
    {"param": "pyramid_scale", "kind": "float", "default": "2", "range": "1 to 8", "maps_to": "PyramidConfig::scale"},
    {"param": "pyramid_taps", "kind": "int", "default": "5", "range": "1 to 15", "maps_to": "PyramidConfig::kernel_taps"},
    {"param": "pyramid_min_size", "kind": "int", "default": "12", "range": "1 to 65536", "maps_to": "PyramidConfig::min_size"},
    {"param": "lambda_init", "kind": "float", "default": "0.0001", "range": "0 to 1e+12", "maps_to": "LmConfig::lambda_init"},
    {"param": "lambda_up", "kind": "float", "default": "10", "range": "1 to 1e+06", "maps_to": "LmConfig::lambda_up"},
    {"param": "lambda_down", "kind": "float", "default": "0.1", "range": "0 to 1", "maps_to": "LmConfig::lambda_down"},
    {"param": "lambda_min", "kind": "float", "default": "1e-09", "range": "0 to 1e+12", "maps_to": "LmConfig::lambda_min"},
    {"param": "max_iterations", "kind": "int", "default": "30", "range": "1 to 100000", "maps_to": "LevelParams::max_iterations"},
    {"param": "max_rejections", "kind": "int", "default": "10", "range": "1 to 100000", "maps_to": "LevelParams::max_rejections"},
    {"param": "step_tol", "kind": "float", "default": "0.001", "range": "0 to 1e+06", "maps_to": "LevelParams::step_tol"},
    {"param": "cost_tol", "kind": "float", "default": "1e-09", "range": "0 to 1", "maps_to": "LevelParams::cost_tol"},
    {"param": "lambda_max", "kind": "float", "default": "100000000", "range": "1e-09 to 1e+18", "maps_to": "LevelParams::lambda_max"},
    {"param": "selection_fraction", "kind": "float", "default": "0.5", "range": "0 to 1", "maps_to": "SelectionConfig::min_fraction"},
    {"param": "min_weight", "kind": "float", "default": "0.05", "range": "0 to 1", "maps_to": "SelectionConfig::min_weight"},
    {"param": "border_is_outside", "kind": "checkbox", "default": "true", "maps_to": "SelectionConfig::border_is_outside"},
    {"param": "ncc", "kind": "checkbox", "default": "false", "maps_to": "NccConfig::enabled"},
    {"param": "ncc_level", "kind": "int", "default": "-1", "range": "-1 to 15", "maps_to": "NccConfig::level"},
    {"param": "ncc_radius", "kind": "int", "default": "6", "range": "0 to 4096", "maps_to": "NccConfig::radius"},
    {"param": "ncc_step", "kind": "int", "default": "1", "range": "1 to 4096", "maps_to": "NccConfig::step"},
    {"param": "ncc_min_valid_fraction", "kind": "float", "default": "0.6", "range": "0 to 1", "maps_to": "NccConfig::min_valid_fraction"},
    {"param": "ncc_min_score", "kind": "float", "default": "0", "range": "-1 to 1", "maps_to": "NccConfig::min_score"},
    {"param": "inlier_threshold", "kind": "float", "default": "0.05", "range": "0 to 1e+06", "maps_to": "Config::inlier_threshold"},
    {"param": "min_valid_pixels", "kind": "int", "default": "12", "range": "1 to 1000000000", "maps_to": "Config::min_valid_pixels"},
    {"param": "refusal", "kind": "popup", "default": "hold", "choices": "hold, fail", "maps_to": "the stage"}
  ],
  "exit_codes_table": [
    {"code": 0, "means": "every input frame was written and the files asked for are in place; an empty input is zero frames", "table": "the table's 0"},
    {"code": 1, "means": "stage_failed: the data file or the report file could not be created, written or moved into place, or a write of a frame failed for a reason other than a closed reader", "table": "the table's stage_failed"},
    {"code": 2, "means": "usage: a bad or missing option, a parameter given twice, one path for data and report", "table": "the table's usage"},
    {"code": 3, "means": "unsupported: a depth other than 8, 16 or 32, a parameter or a layer the stage does not have, a value outside its range or choices, a keyed value on the command line, a configuration the planar-track crate refuses, corners that do not go around a convex region, a refused frame when refusal is fail", "table": "the table's unsupported"},
    {"code": 4, "means": "bad_input, partial_frame or broken_pipe: a failed read, a frame count other than --frames, a reference frame that is not among the frames read, an input that ends inside a frame, a reader that went away", "table": "the table's bad_input, partial_frame and broken_pipe"}
  ],
