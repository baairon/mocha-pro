{
  "schema_version": 1,
  "name": "stage-warp-sphere",
  "summary": "a generic stage of mocha-stage: each full sphere frame turned by a yaw, pitch and roll rotation between equirectangular or cube face layouts, mono or stereo, with the sphere-reorient crate for the coordinates and the resample crate for the samples; a published method under explicit configuration, not compared with any product",
  "binaries": [
    {"name": "mocha-stage", "arguments": "apply warp-sphere --width W --height H --depth 8|16|32 --fps N[/D] [--frames N] [--describe] [--param K=V]... [--layer keys=PATH]", "stdin": "whole raw frames; not read with --describe", "stdout": "the frames of the stage, nothing else; with --describe one line of JSON", "stderr": "empty on exit 0; exactly one line error: CODE: MESSAGE on a failure"}
  ],
  "frame_contract": "frames/2 raw frames: depth 8 is packed rgba (4 bytes per pixel), depth 16 is packed rgba64le (8 bytes), depth 32 is planar gbrapf32le (16 bytes, planes G, B, R, A, 1.0 is full scale); whole frames back to back, no header, no padding, straight alpha, a frame of at most 4 GiB; a stream that ends inside a frame is a partial frame",
  "parameters": [
    {"id": "width", "kind": "int", "default": "0", "accepts": "0 to 65536", "keyed": false, "maps_to": "Output width in pixels; 0 keeps the input width."},
    {"id": "height", "kind": "int", "default": "0", "accepts": "0 to 65536", "keyed": false, "maps_to": "Output height in pixels; 0 keeps the input height."},
    {"id": "filter", "kind": "popup", "default": "bilinear", "accepts": "nearest, bilinear, keys, mitchell, lanczos, box", "keyed": false, "maps_to": "The reconstruction filter (Config::filter)."},
    {"id": "keys_a", "kind": "float", "default": "-0.5", "accepts": "-1 to 0", "keyed": false, "maps_to": "The parameter a of the Keys cubic; read when filter is keys."},
    {"id": "mitchell_b", "kind": "float", "default": "0.3333333333333333", "accepts": "0 to 1", "keyed": false, "maps_to": "The parameter B of the Mitchell and Netravali cubic; read when filter is mitchell."},
    {"id": "mitchell_c", "kind": "float", "default": "0.3333333333333333", "accepts": "0 to 1", "keyed": false, "maps_to": "The parameter C of the Mitchell and Netravali cubic; read when filter is mitchell."},
    {"id": "lobes", "kind": "int", "default": "3", "accepts": "1 to 8", "keyed": false, "maps_to": "The lobes per side of the Lanczos filter; read when filter is lanczos."},
    {"id": "border", "kind": "popup", "default": "clamp", "accepts": "zero, clamp, repeat, mirror, mirror-no-edge", "keyed": false, "maps_to": "What a tap outside the image reads (Config::border)."},
    {"id": "center", "kind": "popup", "default": "half", "accepts": "half, corner", "keyed": false, "maps_to": "Whether pixel i has its centre at i + 0.5 or at i (Config::center)."},
    {"id": "alpha", "kind": "popup", "default": "straight", "accepts": "straight, premultiplied", "keyed": false, "maps_to": "Whether colour is interpolated as it is or multiplied by alpha first and divided afterwards (Config::alpha)."},
    {"id": "normalize", "kind": "popup", "default": "none", "accepts": "none, sum, sum-in-bounds", "keyed": false, "maps_to": "Whether the result is divided by the sum of the tap weights (Config::normalize)."},
    {"id": "tie", "kind": "popup", "default": "half-up", "accepts": "half-up, half-down, half-even", "keyed": false, "maps_to": "Where the nearest filter goes when the coordinate is halfway between two pixels (Config::tie)."},
    {"id": "order", "kind": "popup", "default": "row-major", "accepts": "row-major, column-major", "keyed": false, "maps_to": "The order of the accumulation loop, which matters for rounding only (Config::order)."},
    {"id": "footprint", "kind": "popup", "default": "unit", "accepts": "unit, jacobian", "keyed": false, "maps_to": "The size of the box filter in source pixels: one pixel, or the mapped output pixel (Config::footprint)."},
    {"id": "yaw", "kind": "float", "default": "0", "accepts": "-36000 to 36000", "keyed": true, "maps_to": "The turn about the up axis in degrees; may be keyed."},
    {"id": "pitch", "kind": "float", "default": "0", "accepts": "-36000 to 36000", "keyed": true, "maps_to": "The turn about the x axis in degrees; may be keyed."},
    {"id": "roll", "kind": "float", "default": "0", "accepts": "-36000 to 36000", "keyed": true, "maps_to": "The turn about the axis of longitude zero in degrees; may be keyed."},
    {"id": "in_layout", "kind": "popup", "default": "equirect", "accepts": "equirect, cube-row6, cube-column6, cube-3x2, cube-2x3", "keyed": false, "maps_to": "How the input stores the sphere: equirectangular, or six cube faces in one of four grids (CubeGrid)."},
    {"id": "out_layout", "kind": "popup", "default": "equirect", "accepts": "equirect, cube-row6, cube-column6, cube-3x2, cube-2x3", "keyed": false, "maps_to": "How the output stores the sphere: equirectangular, or six cube faces in one of four grids (CubeGrid)."},
    {"id": "stereo", "kind": "popup", "default": "mono", "accepts": "mono, over-under, side-by-side", "keyed": false, "maps_to": "Whether a frame holds one view or two, and how the two are placed (StereoLayout)."},
    {"id": "lon_zero", "kind": "float", "default": "0.5", "accepts": "0 to 1", "keyed": false, "maps_to": "Where longitude zero lies along the width, as a fraction of the width (Config::lon_zero)."},
    {"id": "lon_direction", "kind": "popup", "default": "increasing-right", "accepts": "increasing-right, increasing-left", "keyed": false, "maps_to": "Whether longitude grows toward larger or smaller columns (Config::lon_direction)."},
    {"id": "sphere_center", "kind": "popup", "default": "centre", "accepts": "centre, corner", "keyed": false, "maps_to": "Whether column i is sampled at (i + 0.5) / width or at i / width of a turn (Config::pixel_center)."},
    {"id": "pole_rows", "kind": "popup", "default": "inset", "accepts": "on-pole, inset", "keyed": false, "maps_to": "Whether the first and the last row lie on the poles or half a row inside them (Config::pole_rows)."},
    {"id": "north", "kind": "popup", "default": "top", "accepts": "top, bottom", "keyed": false, "maps_to": "Which pole is at the first row (Config::north)."},
    {"id": "axis_order", "kind": "popup", "default": "yaw-pitch-roll", "accepts": "yaw-pitch-roll, yaw-roll-pitch, pitch-yaw-roll, pitch-roll-yaw, roll-yaw-pitch, roll-pitch-yaw", "keyed": false, "maps_to": "The order in which the three rotations are multiplied; the last named acts first (Config::axis_order)."},
    {"id": "angle_sign", "kind": "popup", "default": "positive", "accepts": "positive, negated", "keyed": false, "maps_to": "Whether the angles are used as given or negated (Config::angle_sign)."},
    {"id": "rotation_use", "kind": "popup", "default": "direct", "accepts": "direct, transposed", "keyed": false, "maps_to": "Whether the matrix or its transpose takes an output direction to a source direction (Config::rotation_use)."}
  ],
  "layers": [
    {"layer": "keys", "optional": true, "form": "keys-1", "meaning": "A key file with a value per frame for yaw, pitch and roll."}
  ],
  "geometry": "declared: the output is width by height, where 0 keeps the input side; the frame count, the depth and the rate are those of the request; --describe answers the output geometry without reading standard input and without opening a layer; a keyed parameter never changes the geometry; a size that does not fit its layout (a cube layout without square faces, a stereo layout without two views) is refused, also by --describe",
  "sample_rule": "computed on f32 samples: an integer sample v is v / 255 or v / 65535, computed in f64 and rounded once to f32; on the way out a sample x is floor(clamp(x, 0, 1) * max + 0.5) and a sample that is not a number is 0; depth 32 samples are the stream's own floats and are never clamped; each output pixel is sampled by the resample crate at the source position the map of the stage gives for it, under the filter, border, pixel centre, alpha and normalisation rule of the parameters; a pixel without a source position is zero in all four channels; the map is the direction of the output pixel under out_layout, turned by the rotation, as a pixel under in_layout, inside the stereo view of the output pixel; for an equirectangular input a column in the last half pixel before the seam is moved back by one width, so that border decides what lies beyond the first and the last column",
  "error_line": "error: CODE: MESSAGE, one line on standard error, where CODE is usage, unsupported, bad_input, partial_frame, broken_pipe or stage_failed",
  "exit_codes_table": [
    {"code": 0, "means": "every input frame was processed and written, or --describe printed its answer", "table": "the table's 0"},
    {"code": 1, "means": "stage_failed: the output could not be written for a reason other than a closed pipe", "table": "the table's stage_failed"},
    {"code": 2, "means": "usage: a bad or missing option, a parameter or a layer given twice, a layer with an empty path", "table": "the table's usage"},
    {"code": 3, "means": "unsupported: a depth the stage does not take, a parameter or a layer the stage does not have, a value the stage refuses, a transform or a layer content the configuration refuses", "table": "the table's unsupported"},
    {"code": 4, "means": "bad_input, partial_frame or broken_pipe: a failed read, input that ends inside a frame, a frame count other than --frames, a layer file that cannot be read or parsed, a reader that went away", "table": "the table's bad_input, partial_frame and broken_pipe"}
  ],
  "unpinned_paths": [
    {"path": "stage_failed", "exit": 1, "why": "a write to standard output that fails for a reason other than a closed pipe; no test makes one, because it needs a device that differs between systems"},
    {"path": "broken_pipe", "exit": 4, "why": "a reader that closes the pipe while the stage writes; tests/stage_<id>.rs and the convention's conformance tool exercise it, the rows of this file do not"}
  ],
